{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Dara Local",
  "version": "0.1.2",
  "identifier": "com.silo77.dara.local",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzQ0IzNzM5RDUwNjY0QTEKUldTaFpBYlZPVGZMODNiTWFFUlg0MW9MRjNpS2RCRlpzUzRteWxjWFZHT09oYnBiWTIzMHZsbDMK",
      "endpoints": [
        "https://github.com/polyphilz/dara/releases/latest/download/latest.json"
      ]
    }
  },
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Dara Local",
        "width": 1000,
        "height": 720,
        "center": true,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "capabilities": ["main", "quick-add"],
      "freezePrototype": true,
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' blob: data: dara-media:",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:5173",
        "img-src": "'self' blob: data: dara-media:",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/embedding-indexes/jina-v1.json": "embedding-indexes/jina-v1.json",
      "resources/embedding-indexes/jina-v1-golden.json": "embedding-indexes/jina-v1-golden.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
