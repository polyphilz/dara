# Local-only Cloudflare R2 configuration for Litestream protocol verification.
# Copy this file to app/.env.local and fill in the values from a bucket-scoped
# R2 Object Read & Write token. Never use a Cloudflare account API token here.
#
# Production Dara stores the S3 credentials in macOS Keychain instead of an
# environment file.
DARA_LITESTREAM_R2_ACCOUNT_ID="replace-with-cloudflare-account-id"
DARA_LITESTREAM_R2_JURISDICTION="DEFAULT"
DARA_LITESTREAM_R2_BUCKET="replace-with-bucket-name"
DARA_LITESTREAM_R2_PREFIX="dara/litestream-protocol-tests"
DARA_LITESTREAM_R2_ACCESS_KEY_ID="replace-with-r2-access-key-id"
DARA_LITESTREAM_R2_SECRET_ACCESS_KEY="replace-with-r2-secret-access-key"
